# For docker-compose.yml
POSTGRES_USER=halfface
POSTGRES_PASSWORD=halfface_dev_pw
POSTGRES_DB=halfface_lab
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=720h

# Hostname caddy requests a Let's Encrypt cert for. Must resolve (DNS) to
# this machine's public IP before `docker compose up`. No domain yet? Use
# a nip.io hostname built from the VM's external IP, e.g. for 34.64.12.99:
DOMAIN=34.64.12.99.nip.io
