DATABASE_URL="postgresql://halfface:halfface_dev_pw@127.0.0.1:5432/halfface_lab?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
# The MVP frontend has no login screen — it silently registers/reuses a
# guest account and expects the token to stay valid across sessions, so
# this is set long rather than the usual short-lived access token.
JWT_EXPIRES_IN="720h"
PORT=3000
NODE_ENV=development
